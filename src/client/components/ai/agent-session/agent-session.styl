.agent-session-overlay-inner
  height 100%
  min-height 0
  max-height 60vh
  display flex
  flex-direction column
  color var(--text)
  background rgba(39, 39, 39, .98)
  border 1px solid rgba(255, 255, 255, .08)
  border-radius 5px
  box-shadow 0 10px 28px rgba(0, 0, 0, .35)
  overflow hidden
  pointer-events auto
  position relative
  box-sizing border-box

.agent-session-decoration
  pointer-events auto
  box-sizing border-box
  padding 2px 8px
  overflow hidden

.agent-session-overlay-inner.is-embedded
  height 100%
  max-height none
  border-radius 4px
  box-shadow none
  background rgba(39, 39, 39, .99)

.agent-session-overlay-inner.is-embedded.is-thinking-only
  min-height 0
  .agent-session-header.is-minimal
    height 100%
    min-height 0
    padding 0 12px

.agent-session-overlay-inner.is-embedded
  .agent-approval-card, .agent-user-input-card, .agent-final-card
    max-height none
  .agent-final-card, .agent-approval-card, .agent-user-input-card, .agent-timeline
    overflow visible
  .agent-approval-card.is-resolved
    border-color #3ba272
    background rgba(18, 48, 36, .78)

.agent-session-overlay-inner.is-embedded.is-content-sized
  height auto
  min-height 0
  overflow visible
  .agent-timeline
    flex none
  .agent-approval-card, .agent-user-input-card, .agent-final-card
    flex none
  .agent-approval-command
    max-height none
    overflow visible

.agent-session-overlay-inner.is-thinking-only
  min-height 48px

.agent-session-header
  min-height 38px
  display flex
  justify-content space-between
  align-items center
  gap 12px
  padding 6px 12px
  background rgba(24, 24, 24, .48)
  border-bottom 1px solid rgba(255, 255, 255, .06)
  flex-shrink 0
  box-sizing border-box

.agent-session-header.is-minimal
  height 100%
  min-height 48px
  padding 8px 14px
  background rgba(44, 44, 44, .98)
  border-bottom 0
  color rgba(255, 255, 255, .72)

.agent-session-status, .agent-session-controls, .agent-approval-actions, .agent-user-input-actions
  display flex
  align-items center
  gap 8px
  min-width 0

.agent-session-status strong
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  font-weight 500

.agent-session-meta
  color rgba(255, 255, 255, .5)
  font-size .88em
  white-space nowrap

.agent-session-controls
  flex-shrink 0
  .ant-btn
    color rgba(255, 255, 255, .65)
  .agent-stop-button
    color #9a9a9a
    &:hover
      color #ff6b6b !important

.agent-session-spinner
  width 13px
  height 13px
  flex 0 0 13px
  border 2px dotted rgba(255, 255, 255, .35)
  border-top-color #b6b6b6
  border-radius 50%
  animation agent-session-spin .9s linear infinite

@keyframes agent-session-spin
  to
    transform rotate(360deg)

.agent-session-state-dot
  width 8px
  height 8px
  flex 0 0 8px
  border-radius 50%
  background #8a8a8a
  &.is-complete
    background #48b87a
  &.is-failed, &.is-blocked
    background #e05a5a
  &.is-inconclusive, &.is-partial
    background #d5a436

.agent-current-activity
  display flex
  align-items flex-start
  gap 10px
  padding 9px 14px
  line-height 1.5
  background rgba(46, 46, 46, .96)
  flex-shrink 0

.agent-activity-dot
  width 10px
  height 10px
  margin-top .35em
  border-radius 50%
  background #13b9ef
  box-shadow 0 0 0 2px rgba(19, 185, 239, .1)
  flex 0 0 10px

.agent-plan-details
  margin 0 14px 6px 34px
  color rgba(255, 255, 255, .55)
  font-size .88em
  flex-shrink 0
  summary
    cursor pointer
  p
    margin 5px 0 0

.agent-timeline
  min-height 0
  overflow-y auto
  padding 0 14px 7px
  flex 1 1 auto

.agent-history
  border-top 1px solid rgba(255, 255, 255, .06)

.agent-history-toggle
  border 0
  background transparent
  color rgba(255, 255, 255, .52)
  padding 6px 0
  cursor pointer
  font-size .86em

.agent-step-card
  border-top 1px solid rgba(255, 255, 255, .06)
  &:first-child
    border-top 0
  &.is-current
    background rgba(0, 0, 0, .08)

.agent-step-summary
  width 100%
  display flex
  align-items center
  gap 8px
  padding 7px 0
  color inherit
  border 0
  background transparent
  text-align left
  cursor pointer

.agent-step-title
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.agent-step-spacer
  flex 1

.agent-step-status-icon
  width 16px
  color rgba(255, 255, 255, .55)
  text-align center
  &.is-running
    color #13b9ef
  &.is-success
    color #48b87a
  &.is-warning
    color #d5a436
  &.is-error
    color #e05a5a

.agent-step-status-text, .agent-step-chevron
  color rgba(255, 255, 255, .48)
  font-size .86em
  white-space nowrap

.agent-risk-tag
  margin 0 !important
  font-size .8em

.agent-step-detail
  padding 0 6px 8px 24px
  color rgba(255, 255, 255, .68)
  line-height 1.45
  p
    margin 4px 0
  code
    display block
    padding 6px 8px
    background rgba(0, 0, 0, .2)
    white-space pre-wrap
    word-break break-word
  .agent-step-progress
    color rgba(255, 255, 255, .5)
    font-size .88em

.agent-approval-card, .agent-user-input-card, .agent-final-card
  margin 0 14px 10px
  padding 10px 12px
  border 1px solid #1677ff
  border-radius 5px
  background rgba(8, 24, 48, .75)
  overflow-y auto
  min-height 0
  flex 1 1 auto

.agent-approval-head
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin-bottom 8px

.agent-approval-title
  font-weight 500

.agent-approval-actions
  flex-wrap wrap
  &.is-primary
    justify-content flex-end
  &.is-secondary
    margin-top 8px

.agent-approval-risk-line
  display flex
  align-items center
  gap 7px
  color rgba(255, 255, 255, .58)
  font-size .85em
  margin-bottom 7px
  flex-wrap wrap
  .ant-tag
    margin 0

.agent-approval-command
  margin 0
  padding 9px 10px
  border-radius 4px
  background rgba(20, 20, 20, .9)
  color #f0f0f0
  line-height 1.5
  white-space pre-wrap
  word-break break-word
  max-height 110px
  overflow auto

.agent-approval-editor
  background rgba(20, 20, 20, .9) !important
  color #f0f0f0 !important
  font-family Maple Mono, monospace

.agent-approval-details
  margin-top 7px
  color rgba(255, 255, 255, .62)
  font-size .86em
  summary
    cursor pointer

.agent-approval-card dl, .agent-evidence-meta
  display grid
  grid-template-columns max-content minmax(0, 1fr)
  gap 5px 12px
  margin 8px 0
  dt
    color rgba(255, 255, 255, .46)
  dd
    margin 0
    min-width 0
    word-break break-word

.agent-approval-expiry
  display block
  margin-top 7px
  color rgba(255, 255, 255, .42)

.agent-evidence-content
  white-space pre-wrap
  word-break break-word
  max-height 50vh
  overflow auto
  background #111
  padding 12px

.agent-final-card
  border-color rgba(255, 255, 255, .16)
  background rgba(28, 28, 28, .85)
  flex 0 1 auto
  max-height 45vh
  p
    margin 5px 0
  h3, h4
    margin 5px 0
  h3
    display flex
    align-items center
    gap 8px
    .ant-tag
      margin 0

.agent-final-card.is-complete
  border-color #3ba272
.agent-final-card.is-inconclusive, .agent-final-card.is-partial
  border-color #d5a436
.agent-final-card.is-failed, .agent-final-card.is-blocked
  border-color #d45454

@media (max-width: 720px), (max-height: 260px)
  .terminal-smart-shell-overlay:has(.agent-session-overlay-inner)
    position absolute !important
    left 0 !important
    right 0 !important
    bottom 0 !important
    top auto !important
    width 100% !important
    max-width none !important
    height 70% !important
    max-height 70% !important
  .agent-session-decoration .agent-session-overlay-inner
    position static !important
    width 100% !important
    height 100% !important
    max-height none !important
  .agent-session-decoration .agent-session-overlay-inner.is-content-sized
    height auto !important
  .agent-approval-head
    align-items flex-start
    flex-direction column
  .agent-approval-actions.is-primary
    justify-content flex-start
