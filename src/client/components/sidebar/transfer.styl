.transfer-list-card
  width 920px
  max-width calc(100vw - 72px)
  .ant-popover-content
  .ant-popover-inner
    max-width 100%
  .ant-popover-inner-content
    max-width 100%
    max-height calc(100vh - 120px)
    overflow auto
    box-sizing border-box
    padding 8px 12px

.transfer-popover-body
  max-width 100%
  overflow hidden

.sftp-file
  max-width 220px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  &.history-file
    max-width 260px

.control-icon-wrap
  .ant-badge-count-sm
    font-size 11px
  .ant-badge-multiple-words
    padding 0 3px

.transfer-session-wrap
  display inline-flex
  align-items center
  margin-right 10px
  vertical-align middle
  .ant-badge
    line-height 1
  .ant-badge-count-sm
    font-size 10px
    min-width 14px
    height 14px
    line-height 14px
  .transfer-session-icon
    margin-right 0
    font-size 14px
