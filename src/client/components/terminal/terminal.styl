
.terms-box
  background var(--main)
  position relative
.loading-wrapper
  padding 30px
  z-index 100
.term-search-box
  position absolute
  right 5px
  top 5px
  z-index 30

.terminal-control
  background var(--main)
  line-height 32px
  padding 0 10px

.terms-box
  position relative
.term-wrap
  background var(--main)
  position absolute

.vertical
  .term-wrap.not-first-term
    border-top 1px solid var(--main-lighter)
.horizontal
  .term-wrap.not-first-term
    border-left 1px solid var(--main-lighter)

#container
  .xterm
    background transparent
  .xterm-viewport
    background-color transparent !important
  .xterm-screen::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background-repeat no-repeat
    background-position center
    background-color transparent !important

.terminal-normal-buffer
  position absolute
  left 0
  top 0
  width 100%
  background var(--main)
  color var(--text)
  box-shadow 0px 3px 3px 0px var(--main-lighter)
  z-index 66
  padding-bottom 32px
.terminal-normal-buffer-body
  overflow-y scroll
  max-height 300px
.terminal-normal-buffer-close
  cursor pointer
  font-size 14px
  color var(--text)
  &:hover
    color var(--text-light)
.terminal-normal-buffer-footer
  position absolute
  left 0
  top calc(100% - 32px)
  width 100%
  height 32px
  line-height 32px
  box-shadow 0px -3px 3px 0px var(--main)
  background var(--main-lighter)
.batch-input-wrap
  width calc(100% - 80px)

.terminal-suggestions-wrap
  position absolute
  z-index 100
  max-height 300px
  max-width 300px
  min-width 200px
  box-shadow 0px 0px 3px 3px var(--main-lighter)
  display flex
  flex-direction column
  background var(--main)
  border-radius 4px
  &.reverse .terminal-suggestions-list
    border-top 1px solid var(--main-lighter)
    border-bottom none

.terminal-suggestions-list
  flex 1
  overflow-x hidden
  overflow-y auto
  max-height 268px
  max-width 300px
  border-bottom 1px solid var(--main-lighter)

.terminal-suggestions-sticky
  flex-shrink 0
  height 32px
  padding 0 10px
  line-height 32px

.suggestion-item
  display flex
  align-items center
  padding 5px 10px
  cursor pointer
  color var(--text)
  &:hover
    background-color var(--main-lighter)
    .suggestion-delete
      visibility visible

.suggestion-command
  flex-grow 1
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.suggestion-type
  margin-left 5px
  font-size 0.8em
  color var(--text)
  &:hover
    color var(--success)

.suggestion-hint
  margin-left 5px
  font-size 0.8em
  color var(--text-light, #888)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  max-width 150px

.suggestion-delete
  margin-left 5px
  visibility hidden

.term-search-bar
  position absolute
  right 0
  top 0
  bottom 0
  background transparent
  width 16px
.paste-text
  max-height 200px
  overflow-y scroll

.terminal-reconnect-overlay
  position absolute
  bottom 6px
  right 12px
  font-size 11px
  color rgba(255, 255, 255, 0.55)
  pointer-events none
  z-index 110

.terminal-smart-shell-overlay
  position absolute
  left 24px
  right 24px
  bottom 88px
  z-index 120
  pointer-events none
  box-sizing border-box
  &.is-anchored
    right auto
    bottom auto
    max-width calc(100% - 24px)
    overflow hidden

.terminal-smart-shell-card
  pointer-events auto
  border 1px solid #2f6fed
  background rgba(17, 26, 43, 0.96)
  border-radius 10px
  box-shadow 0 16px 40px rgba(0, 0, 0, 0.35)
  overflow hidden
  backdrop-filter blur(8px)
  height 100%
  display flex
  flex-direction column
  box-sizing border-box

.terminal-smart-shell-head
  flex-shrink 0
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px
  padding 0.9em 1em 0.65em
  background rgba(39, 58, 90, 0.75)

.terminal-smart-shell-title
  color var(--text)
  font-size 1.05em
  font-weight 600
  line-height 1.4
  padding-top 2px

.terminal-smart-shell-buttons
  display flex
  align-items center
  gap 8px
  flex-wrap wrap

.terminal-smart-shell-message
  flex-shrink 0
  padding 0.9em 1em 0.5em
  color var(--text)
  font-size 1em
  line-height 1.6

.terminal-smart-shell-meta
  display flex
  align-items center
  gap 8px
  padding 0 1em 0.65em
  flex-wrap wrap

.terminal-smart-shell-context
  padding 0 1em 0.65em
  color rgba(255, 255, 255, 0.68)
  font-size 0.85em
  line-height 1.5

.terminal-smart-shell-command
  flex 1 1 auto
  // 强制至少 3 行可视高度（行高 1.6em × 3 + 上下 padding）
  min-height calc(1.6em * 3 + 1.8em)
  height calc(1.6em * 3 + 1.8em)
  max-height calc(1.6em * 3 + 1.8em)
  margin 0 1em 0.75em
  padding 0.9em 1em
  border-radius 8px
  background #151515
  color #f2f2f2
  font-size 1em
  line-height 1.6
  white-space pre-wrap
  word-break break-word
  overflow-x hidden
  overflow-y auto
  box-sizing border-box

.terminal-smart-shell-command.empty
  color rgba(255, 255, 255, 0.5)
  font-style italic

.terminal-smart-shell-editor
  flex 1 1 auto
  min-height calc(1.6em * 3 + 1.8em)
  height calc(1.6em * 3 + 1.8em)
  max-height calc(1.6em * 3 + 1.8em)
  margin 0 1em 0.75em
  background #151515 !important
  border-color #2f6fed !important
  color #f2f2f2 !important
  font-family Maple Mono, monospace
  resize none
  box-sizing border-box
  textarea
    background #151515 !important
    color #f2f2f2 !important
    font-family inherit
    line-height 1.6
    height 100% !important
    min-height calc(1.6em * 3) !important
    max-height 100% !important
    overflow-y auto !important
    resize none !important

.terminal-smart-shell-notes
  flex-shrink 1
  min-height 0
  max-height 4.8em
  overflow-y auto
  padding 0 1em 0.9em
  color rgba(255, 255, 255, 0.78)
  line-height 1.6
  font-size 0.95em

.terminal-error-handle
  position absolute
  left 0
  top 0
  z-index 100
  background var(--main)
  max-width calc(100% - 24px)

.terminal-fontsize-reset
  position absolute
  left 8px
  bottom 4px
