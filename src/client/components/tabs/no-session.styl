.no-sessions
  background var(--main)
  text-align center
  // stack buttons / logo / history; the history flexes to fill the remaining
  // height, so the layout adapts to logo size and button wrapping without any
  // fixed pixel offsets.
  display flex
  flex-direction column
  position absolute
  top 36px
  left 0
  right 0
  bottom 0
  padding 50px 0
  z-index 11
.no-session-btns
  flex-shrink 0
  display flex
  flex-wrap wrap
  justify-content center
  align-items center
  gap 8px
  padding-bottom 8px
.no-session-logo
  flex-shrink 0
  padding 32px 0
.no-session-history
  flex 1
  min-height 0
  display flex
  flex-direction column
  overflow hidden
  .no-session-connections
    width 420px
    max-width 90vw
    margin 0 auto
    text-align left
    flex 1
    min-height 0
    overflow auto
  .no-session-connections-loading
    display flex
    align-items center
    justify-content center
    min-height 160px
    padding 24px 0

  .sidebar-panel-history
    // override the global sidebar absolute positioning (top:112px) so the
    // history fills this flex item instead.
    position static
    flex 1
    min-height 0
    .pd2x
      width 400px
      max-width 90vw
      margin 0 auto
      text-align left
      overflow auto
      max-height 100%
.is-mobile
  .no-sessions
    padding 20px 0
  .no-session-logo
    padding 8px 0
  .no-session-history
    .no-session-connections
      width auto
      max-width 400px
    .sidebar-panel-history
      .pd2x
        width auto
        max-width 400px
