.logo-img
  height 80px
.logo-img-small
  height 28px
  border-radius 28px
.opshalo-wordmark
  display inline-block
  margin-right 12px
  font-weight 700
  letter-spacing 1px
  color var(--text)
  text-shadow 0 0 18px rgba(0, 136, 204, .45)
// the h1 vertical margin so the logo stops dominating the no-session panel.
.is-mobile
  .logo-elem
    margin-top 8px
    margin-bottom 8px
  .morph-shape
    padding 6px
  .logo-img
    height 32px
  .logo-img-small
    height 20px
